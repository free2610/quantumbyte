# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Google Gemini AI Configuration
# Tavsiya etilgan tejamkor va tezkor model: gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Admin Telegram ID lari (JSON list ko'rinishida, masalan: [123456789, 987654321])
ADMIN_IDS=[]

# Ma'lumotlar bazasi fayl manzili
DATABASE_PATH=./data/fika_quiz.db

# Standart til: uz (o'zbekcha) yoki ru (ruscha)
DEFAULT_LANGUAGE=uz

# Foydalanuvchining kunlik AI test yaratish limiti
AI_DAILY_LIMIT=10

# Log darajasi: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
